# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/rust_auth?schema=public

# -----------------------------------------------------------------------------
# JSON Web Token Credentials
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=my_ultra_secure_jwt_secret_key
JWT_MAXAGE=60

# -----------------------------------------------------------------------------
# Local OAuth2 Mock Server Configuration
# -----------------------------------------------------------------------------
# Application URL (used for YOUR server's external address)
APP_URL=http://localhost:8080

# Credentials for your Actix client (can be static dummy values for a mock server)
MOCK_OAUTH_CLIENT_ID=actix_dev_client
MOCK_OAUTH_CLIENT_SECRET=actix_dev_secret_key

# Endpoints for the MOCK Authorization Server (change 8081 if needed)
MOCK_OAUTH_SERVER_BASE_URL=http://localhost:8081
MOCK_OAUTH_AUTHORIZE_URL=${MOCK_OAUTH_SERVER_BASE_URL}/dev-issuer/authorize
MOCK_OAUTH_TOKEN_URL=${MOCK_OAUTH_SERVER_BASE_URL}/dev-issuer/token
MOCK_OAUTH_USERINFO_URL=${MOCK_OAUTH_SERVER_BASE_URL}/dev-issuer/userinfo

# Redirect URI for your Actix server's callback endpoint (must match your Actix route)
MOCK_OAUTH_REDIRECT_URI=http://localhost:8080/api/oauth/mock/callback

# OAuth2 Frontend Redirect (where to redirect after successful OAuth login)
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/dashboard